<script>
  const drawGrid = (canvas: HTMLCanvasElement) => {
    const { width, height } = canvas.getBoundingClientRect();
    if (!width || !height) return;

    const ratio = Math.min(devicePixelRatio, 1.5);
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);

    const context = canvas.getContext('2d');
    if (!context) return;
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    context.clearRect(0, 0, width, height);

    const spacing = Math.max(28, Math.min(46, width / 24));
    const ink = canvas.dataset.grid === 'terrain' ? '239,237,227' : '239,237,227';
    context.lineWidth = 1;

    for (let x = spacing; x < width; x += spacing) {
      context.strokeStyle = `rgba(${ink},${Math.round(x / spacing) % 4 === 0 ? .11 : .045})`;
      context.beginPath();
      context.moveTo(Math.round(x) + .5, 0);
      context.lineTo(Math.round(x) + .5, height);
      context.stroke();
    }

    for (let y = spacing; y < height; y += spacing) {
      context.strokeStyle = `rgba(${ink},${Math.round(y / spacing) % 4 === 0 ? .11 : .045})`;
      context.beginPath();
      context.moveTo(0, Math.round(y) + .5);
      context.lineTo(width, Math.round(y) + .5);
      context.stroke();
    }

    context.strokeStyle = `rgba(${ink},.2)`;
    context.fillStyle = '#f22987';
    context.font = '11px VT323';
    context.fillText(`GRID ${Math.round(width)}:${Math.round(height)}`, 14, height - 14);

    if (canvas.dataset.grid === 'terrain') {
      const center = width * .57;
      for (let band = 0; band < 8; band++) {
        context.strokeStyle = `rgba(${ink},${.08 + band * .015})`;
        context.beginPath();
        for (let x = 0; x <= width; x += 5) {
          const peak = Math.exp(-((x - center) ** 2) / (width * width * .055)) * height * .28;
          const y = height * (.62 + band * .043) - peak + Math.sin(x * .026 + band) * 7;
          if (x === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.stroke();
      }
    } else {
      context.strokeStyle = `rgba(${ink},.12)`;
      context.beginPath();
      context.moveTo(width * .42, height * .18);
      context.lineTo(width * .68, height * .72);
      context.lineTo(width * .9, height * .3);
      context.stroke();
      for (const [x, y] of [[.42,.18],[.68,.72],[.9,.3]]) {
        context.fillStyle = '#f22987';
        context.fillRect(width * x - 2, height * y - 2, 4, 4);
      }
    }
  };

  const drawInkDivider = (canvas: HTMLCanvasElement) => {
    const { width, height } = canvas.getBoundingClientRect();
    if (!width || !height) return;

    const ratio = Math.min(devicePixelRatio, 1.5);
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);

    const context = canvas.getContext('2d');
    if (!context) return;
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    context.clearRect(0, 0, width, height);
    context.lineCap = 'round';
    context.lineJoin = 'round';

    let state = Number(canvas.dataset.inkSeed ?? 1) * 2654435761;
    const random = () => {
      state ^= state << 13;
      state ^= state >>> 17;
      state ^= state << 5;
      return (state >>> 0) / 4294967296;
    };
    const ink = canvas.dataset.inkTone === 'light' ? '239,237,227' : '10,10,9';

    const drawStroke = (edge: 'bottom' | 'right') => {
      const horizontal = edge === 'bottom';
      const length = horizontal ? width : height;
      const baseline = (horizontal ? height : width) - 1.4;

      for (let pass = 0; pass < 3; pass++) {
        context.beginPath();
        for (let position = 0; position <= length; position += 2) {
          const drift = Math.sin(position / (19 + pass * 5) + state * 1e-7) * (.42 + pass * .12);
          const grain = (random() - .5) * 1.35;
          const offset = drift + grain + (pass - 1) * .3;
          const x = horizontal ? position : baseline + offset;
          const y = horizontal ? baseline + offset : position;
          if (position === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.strokeStyle = `rgba(${ink},${.3 + pass * .14})`;
        context.lineWidth = .55 + pass * .25;
        context.stroke();
      }

      for (let position = 5 + random() * 8; position < length; position += 5 + random() * 18) {
        const offset = (random() - .5) * 1.7;
        context.beginPath();
        context.arc(
          horizontal ? position : baseline + offset,
          horizontal ? baseline + offset : position,
          .28 + random() * .74,
          0,
          Math.PI * 2,
        );
        context.fillStyle = `rgba(${ink},${.28 + random() * .38})`;
        context.fill();
      }
    };

    const edges = canvas.dataset.inkEdges?.split(' ') ?? [];
    if (edges.includes('bottom')) drawStroke('bottom');
    if (edges.includes('right')) drawStroke('right');
  };

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-grid], canvas[data-ink-edges]');
  const resizeObserver = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      const canvas = target as HTMLCanvasElement;
      if (canvas.dataset.grid) drawGrid(canvas);
      else drawInkDivider(canvas);
    }
  });
  canvases.forEach((canvas) => resizeObserver.observe(canvas));
</script>
