---
import { Picture } from 'astro:assets';
import Html from '~/components/page/Html.astro';
import { data } from '~/data/data';
import profileCutout from '~/assets/images/profile-cutout.webp';

const profile = data.profile;
const posts = await data.posts.getPublished();
const chapters = posts.slice(0, 5);
const year = new Date().getFullYear();
const jsonLd = await profile.getJsonLd();
---

<Html
  title={`${profile.name} — Ideas, systems, humans`}
  description={profile.tagline ?? profile.name}
  jsonLd={jsonLd}
  themeColor="#0a0a09"
  hideHeader
  hideFooter
>
  <div class="manifesto-page">
    <svg class="effect-defs" aria-hidden="true">
      <defs>
        <filter id="hero-paper-tear" x="-32%" y="-6%" width="164%" height="112%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".006 .022" numOctaves="4" seed="19" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="34" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="paper-tear-a" x="-24%" y="-8%" width="148%" height="116%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".012 .044" numOctaves="3" seed="29" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="17" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="paper-tear-b" x="-24%" y="-8%" width="148%" height="116%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".009 .038" numOctaves="4" seed="43" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="19" xChannelSelector="B" yChannelSelector="R" />
        </filter>
        <filter id="paper-tear-c" x="-24%" y="-8%" width="148%" height="116%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".015 .052" numOctaves="3" seed="71" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="15" xChannelSelector="G" yChannelSelector="B" />
        </filter>
      </defs>
    </svg>
    <main class="edition">
      <section class="lead" aria-labelledby="manifesto-title">
        <div class="hero-panel">
          <header class="masthead">
            <a class="wordmark" href="/" aria-label="Morten Olsen, home">Morten Olsen<span>.pro</span></a>
            <nav class="primary-nav" aria-label="Primary navigation">
              <a class="active" href="/"><span class="nav-index">01</span><span class="nav-label"> Home</span></a>
              <a href="/posts/"><span class="nav-index">02</span><span class="nav-label"> Writings</span></a>
              <a href="/projects/"><span class="nav-index">03</span><span class="nav-label"> Projects</span></a>
              <a href="/about/"><span class="nav-index">04</span><span class="nav-label"> About</span></a>
            </nav>
            <p class="masthead-note">Ideas. Systems. Humans.<i aria-hidden="true"></i></p>
          </header>
          <canvas class="technical-grid hero-grid" data-grid="hero" aria-hidden="true"></canvas>

          <div class="hero-copy">
            <p class="issue">Independent engineer / Copenhagen</p>
            <h1 id="manifesto-title">
              <span class="title-line">Manifesto /</span>
              <span class="title-line title-pink">Human context</span>
            </h1>
            <div class="intro-row">
              <p class="scribble">Technology should expand<br />what it means to be human.</p>
              <div class="intro-copy">
                <p>I'm Morten Olsen.<br />Software engineer, thinker, and writer.<br />I build AI systems — and stay focused<br />on the human stakes.</p>
                <a href="/about/">Explore the manifesto <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>

          <div class="portrait" aria-hidden="true">
            <Picture
              src={profileCutout}
              alt=""
              formats={['webp']}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 640px) 100vw, (max-width: 1180px) 60vw, 42vw"
              fetchpriority="high"
            />
          </div>

          <aside class="hero-note">
            <strong>Better<br />abstractions.<br />A kinder<br />tomorrow.</strong>
            <span class="short-rule"></span>
            <p>AI agents<br />tools<br />people<br />consequences<br />···</p>
            <em>Still human.<br />Still curious.</em>
          </aside>
        </div>

        <div class="below-fold">
          <article class="quote-panel">
            <div class="quote-sheet" aria-hidden="true"></div>
            <div class="city-silhouette" aria-hidden="true"></div>
            <blockquote>“A more<br />human future<br />is a technical<br />problem.”</blockquote>
            <div class="quote-rule" aria-hidden="true"></div>
            <p><strong>— Morten Olsen</strong><span>Software engineer<br />Writer<br />Persistent optimist</span></p>
          </article>

          <article class="horizon-panel">
            <canvas class="technical-grid terrain-grid" data-grid="terrain" aria-hidden="true"></canvas>
            <div class="horizon-copy">
              <p class="hand-note">Curiosity<br />compounds.</p>
              <p class="coordinates">Same questions.<br />Deeper layers.<br />A longer horizon.</p>
            </div>
            <div class="mountains" aria-hidden="true">
              <span class="mountain mountain-one"></span>
              <span class="mountain mountain-two"></span>
              <span class="mountain mountain-three"></span>
              <span class="contour contour-one"></span>
              <span class="contour contour-two"></span>
            </div>
            <nav class="field-notes" aria-label="Explore the site">
              <a href="/posts/"><span>01</span> Writing</a>
              <a href="/projects/"><span>02</span> Projects</a>
              <a href="/about/"><span>03</span> Notes</a>
              <a href="/about/"><span>04</span> Ideas</a>
              <span class="field-arrow" aria-hidden="true">→</span>
            </nav>
            <p class="tool-note">Small tools.<br />Bigger questions.</p>
          </article>
        </div>
        <canvas class="ink-divider ink-divider-bridge" data-ink-edges="right" data-ink-seed="3" aria-hidden="true"></canvas>
      </section>

      <aside class="chapters" aria-label="Latest writing">
        {chapters.map((post, index) => (
          <article class:list={['chapter', { featured: index === 0 }]}>
            <a href={`/posts/${post.id}`}>
              <div class="chapter-art" aria-hidden="true">
                <Picture
                  src={post.data.heroImage}
                  alt=""
                  formats={['webp']}
                  widths={[320, 560, 840]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1180px) 50vw, 33vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="chapter-copy">
                <p class="chapter-number">Chapter {String(index + 1).padStart(2, '0')}</p>
                <h2>{post.data.title}</h2>
                <p class="chapter-description">{post.data.description}</p>
                <span class="read-link">Read the essay <b aria-hidden="true">→</b></span>
              </div>
            </a>
            <canvas class="ink-divider" data-ink-edges="bottom right" data-ink-seed={index + 11} aria-hidden="true"></canvas>
          </article>
        ))}
        <a class="all-writing" href="/posts/"><span>Index / {posts.length} writings</span><b aria-hidden="true">→</b></a>
      </aside>
    </main>

    <footer class="status-bar">
      <a class="monogram" href="/" aria-label="Home">MØ</a>
      <span>Building a more human tomorrow</span>
      <span>Code \ ideas \ people \ context</span>
      <span>© {year} Morten Olsen</span>
      <span class="curious">Stay curious.<i aria-hidden="true"></i></span>
    </footer>
  </div>
</Html>

<style>
  :global(html), :global(body) { background: #0a0a09; }
  :global(body) { color: #f0ede3; overflow-x: clip; }
  :global(p) { margin: 0; }

  .manifesto-page {
    --ink: #0a0a09;
    --paper: #efede3;
    --pink: #f22987;
    --muted: #aaa79d;
    --line: rgba(239, 237, 227, .48);
    position: relative;
    min-width: 320px;
    min-height: 100svh;
    isolation: isolate;
    background: var(--ink);

    color: var(--paper);
    font-family: 'Space Grotesk', sans-serif;
  }
  .effect-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .manifesto-page::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    opacity: .72;
    background: url('/paper-grain-light.webp') 0 0 / 192px 192px repeat;
    mix-blend-mode: screen;
  }

  .edition {
    display: grid;
    grid-template-columns: minmax(0, 2.05fr) minmax(380px, 1fr);
    height: max(840px, calc(100svh - 38px));
    border-bottom: 1px solid var(--line);
  }

  .lead {
    position: relative;
    display: grid;
    grid-template-rows: 62% 38%;
    min-width: 0;
  }

  .hero-panel {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background:
      url('/paper-grain-light.webp') 0 0 / 192px 192px repeat,
      linear-gradient(rgba(239,237,227,.035) 1px, transparent 1px) 0 0 / 42px 42px,
      linear-gradient(90deg, rgba(239,237,227,.035) 1px, transparent 1px) 0 0 / 42px 42px,
      radial-gradient(circle at 58% 46%, #242422 0, #111 26%, transparent 51%),
      var(--ink);
    background-blend-mode: screen, normal, normal, normal, normal;
    border-bottom: 1px solid var(--line);
  }

  .technical-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ink-divider {
    position: absolute;
    inset: 0;
    z-index: 30;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ink-divider[data-ink-edges='right'] {
    left: auto;
    width: 4px;
  }

  .ink-divider-bridge {
    right: 0;
    width: 5px;
  }

  .hero-grid { opacity: .5; }
  .terrain-grid { opacity: .78; }

  .hero-panel::after {
    content: '';
    position: absolute;
    z-index: 4;
    right: 13.4%;
    bottom: -1px;
    width: 88%;
    height: 18px;
    background: var(--ink);
    clip-path: polygon(0 58%,3% 38%,8% 72%,13% 42%,18% 64%,24% 37%,29% 68%,36% 44%,42% 72%,48% 38%,54% 61%,60% 39%,68% 71%,74% 42%,81% 66%,88% 40%,94% 70%,100% 45%,100% 100%,0 100%);
  }

  .masthead {
    position: absolute;
    inset: 0 0 auto;
    z-index: 14;
    height: 58px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 0 30px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .wordmark {
    color: var(--paper);
    font-family: 'Archivo Black', sans-serif;
    font-size: 17px;
    font-kerning: normal;
    font-feature-settings: 'kern' 1;
    letter-spacing: .045em;
    text-rendering: optimizeLegibility;
  }
  .wordmark span { margin-left: .035em; letter-spacing: .015em; }
  .primary-nav { display: flex; gap: clamp(20px, 2.3vw, 36px); font-size: 13px; }
  .primary-nav a { color: var(--paper); white-space: nowrap; }
  .primary-nav a::after { content: ''; display: block; width: 0; height: 1px; margin-top: 2px; background: currentColor; transition: width 160ms ease; }
  .primary-nav a:hover::after, .primary-nav .active::after { width: 100%; }
  .masthead-note { justify-self: end; display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 13px; }
  .masthead-note i, .curious i { display: inline-block; width: 9px; height: 9px; background: var(--pink); border-radius: 50%; }

  .hero-copy { position: absolute; inset: 70px 0 0 30px; z-index: 12; width: 76%; }
  .issue { display: none; font: 13px 'VT323', monospace; text-transform: uppercase; letter-spacing: .08em; }
  h1 {
    margin: 0;
    color: var(--paper);
    font-family: 'Archivo Black', Impact, sans-serif;
    font-size: clamp(5.4rem, 10.2vw, 10.4rem);
    font-weight: 400;
    line-height: .78;
    letter-spacing: -.06em;
    text-transform: uppercase;
  }
  .title-line { display: block; width: 142%; transform: scaleX(.69); transform-origin: left center; white-space: nowrap; }
  .title-line:first-child {
    font-family: 'Archivo Narrow', sans-serif;
    font-weight: 700;
    font-kerning: normal;
    font-feature-settings: 'kern' 1;
    letter-spacing: -.035em;
    transform: scaleX(.9);
  }
  .title-pink { color: var(--pink); letter-spacing: -.055em; }

  .intro-row {
    display: grid;
    grid-template-columns: 180px minmax(270px, 1fr);
    gap: 24px;
    align-items: end;
    width: min(610px, 75%);
    margin-top: 34px;
  }
  .scribble, .hero-note em, .hand-note, .tool-note { font-family: 'Rock Salt', cursive; font-style: normal; font-weight: 400; text-transform: uppercase; }
  .scribble { color: var(--paper); font-size: 14px; line-height: 1.5; transform: rotate(-5deg); }
  .intro-copy { font-family: 'VT323', monospace; font-size: 17px; line-height: 1.08; }
  .intro-copy p { line-height: inherit; }
  .intro-copy a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 18px;
    padding: 9px 15px 7px;
    border: 2px solid var(--pink);
    color: var(--pink);
    font: 700 11px 'Space Grotesk', sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: background 150ms ease, color 150ms ease;
  }
  .intro-copy a:hover { background: var(--pink); color: var(--ink); }

  .portrait {
    position: absolute;
    z-index: 11;
    right: 16%;
    bottom: -1px;
    width: 52%;
    height: 96%;
    overflow: hidden;
    opacity: .94;
    pointer-events: none;
    transform: translateZ(0);
  }
  .portrait :global(picture), .portrait :global(img) { width: 100%; height: 100%; }
  .portrait :global(img) { display: block; object-fit: cover; object-position: 50% 100%; filter: contrast(1.3) brightness(.92); }

  .hero-note {
    position: absolute;
    z-index: 13;
    inset: 0 0 0 auto;
    width: 16.2%;
    min-width: 156px;
    padding: 72px 22px 24px 34px;
    isolation: isolate;
    color: var(--ink);
    font-family: 'Archivo Black', sans-serif;
    text-transform: uppercase;
  }

  .hero-note::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -8px -4px -8px -12px;
    background:
      url('/paper-grain.webp') 0 0 / 192px 192px repeat,
      linear-gradient(105deg, rgba(10,10,9,.08), transparent 18%),
      var(--paper);
    background-blend-mode: multiply, normal, normal;
    filter: url('#hero-paper-tear') drop-shadow(-2px 0 0 rgba(0,0,0,.38));
  }
  .hero-note strong { display: block; font-size: clamp(15px, 1.25vw, 21px); line-height: .98; }
  .short-rule { display: block; width: 36px; height: 1px; margin: 28px 0 22px; background: var(--ink); }
  .hero-note p { font: 16px/.95 'VT323', monospace; }
  .hero-note em { position: absolute; right: 17px; bottom: 48px; color: var(--pink); font-size: 15px; line-height: 1.45; transform: rotate(-7deg); }

  .below-fold { display: grid; grid-template-columns: 43% 57%; min-height: 0; overflow: hidden; }
  .quote-panel, .horizon-panel { position: relative; min-width: 0; }
  .horizon-panel { overflow: hidden; }
  .quote-panel { z-index: 2; padding: clamp(22px, 2.4vw, 42px) 22px 22px 12%; isolation: isolate; overflow: visible; color: var(--ink); }
  .quote-sheet {
    position: absolute;
    z-index: -1;
    inset: -6px -14px -6px -8px;
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper);
    background-blend-mode: multiply;
    filter: url('#paper-tear-b') drop-shadow(2px 0 0 rgba(10,10,9,.2));
  }
  .quote-panel::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: -5px auto -5px -8px;
    width: 22%;
    background: linear-gradient(90deg,rgba(10,10,9,.95),rgba(10,10,9,.18)),repeating-linear-gradient(105deg,transparent 0 16px,rgba(10,10,9,.5) 17px 19px);
    filter: url('#paper-tear-c');
  }
  .quote-panel blockquote { position: relative; z-index: 1; margin: 0; font: 700 clamp(31px, 3.15vw, 52px)/.88 'Fraunces', serif; letter-spacing: -.055em; }
  .quote-rule { position: relative; z-index: 1; width: 58%; height: 6px; margin: 12px 0 8px; background: var(--pink); transform: rotate(-4deg); clip-path: polygon(0 45%,18% 0,42% 33%,62% 9%,100% 55%,77% 100%,38% 68%,13% 94%); }
  .quote-panel > p { position: relative; z-index: 1; display: flex; gap: 20px; margin-left: 34%; font: 12px/1.1 'VT323', monospace; text-transform: uppercase; }
  .quote-panel > p strong { font-family: 'Space Grotesk', sans-serif; white-space: nowrap; }
  .city-silhouette {
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    opacity: .17;
    background: linear-gradient(75deg,transparent 0 8%,#0a0a09 8% 12%,transparent 12% 18%,#0a0a09 18% 24%,transparent 24% 31%,#0a0a09 31% 35%,transparent 35% 52%,#0a0a09 52% 62%,transparent 62%),repeating-linear-gradient(90deg,#0a0a09 0 3px,transparent 3px 22px);
    clip-path: polygon(0 100%,0 58%,8% 58%,8% 20%,12% 20%,12% 70%,20% 70%,20% 45%,27% 45%,27% 74%,39% 74%,39% 34%,44% 34%,44% 68%,52% 68%,52% 9%,56% 9%,56% 57%,69% 57%,69% 40%,76% 40%,76% 76%,86% 76%,86% 51%,94% 51%,94% 66%,100% 66%,100% 100%);
  }

  .horizon-panel {
    background:
      url('/paper-grain-light.webp') 0 0 / 192px 192px repeat,
      linear-gradient(rgba(239,237,227,.045) 1px, transparent 1px) 0 0 / 36px 36px,
      linear-gradient(90deg, rgba(239,237,227,.045) 1px, transparent 1px) 0 0 / 36px 36px,
      var(--ink);
    background-blend-mode: screen, normal, normal, normal;
  }
  .horizon-copy { position: absolute; z-index: 3; inset: 26px auto auto 30px; }
  .hand-note { font-size: clamp(22px, 2.2vw, 34px); line-height: 1.35; transform: rotate(-7deg); }
  .hand-note::after { content: ''; display: block; width: 76%; height: 7px; margin: 10px auto 0; background: var(--pink); transform: rotate(-5deg); clip-path: polygon(0 51%,21% 11%,55% 31%,100% 0,92% 76%,56% 100%,20% 65%); }
  .coordinates { margin-top: clamp(42px, 7vw, 96px); color: var(--muted); font: 13px/1.35 'VT323', monospace; text-transform: uppercase; letter-spacing: .05em; }
  .field-notes {
    position: absolute;
    z-index: 4;
    top: 24px;
    right: 22px;
    width: 36%;
    display: flex;
    flex-direction: column;
    padding: 8px 0 10px 20px;
    border-left: 1px solid var(--line);
    font: 700 13px/1.15 'Space Grotesk', sans-serif;
    letter-spacing: .035em;
    text-transform: uppercase;
  }
  .field-notes a {
    display: grid;
    grid-template-columns: 28px 1fr;
    padding: 4px 0;
    border-bottom: 1px solid rgba(239,237,227,.28);
    color: var(--paper);
  }
  .field-notes a span { color: var(--pink); font: 15px 'VT323', monospace; }
  .field-notes a:hover { padding-left: 5px; color: var(--pink); }
  .field-arrow { margin-top: 4px; color: var(--pink); font: 38px/1 'Space Grotesk', sans-serif; text-align: right; }

  .mountains { position: absolute; inset: 20% 7% -5% 25%; opacity: .75; }
  .mountain, .contour { position: absolute; inset: auto 0 0; display: block; transform-origin: bottom; }
  .mountain { height: 82%; background: linear-gradient(140deg,#eee 0 1.5%,#333 2% 23%,#c9c9c5 24% 25%,#1b1b1a 26% 50%,#777 51% 52%,#111 53%); clip-path: polygon(0 100%,5% 79%,15% 72%,23% 55%,31% 61%,42% 26%,48% 42%,56% 12%,65% 55%,73% 39%,82% 66%,89% 53%,100% 100%); }
  .mountain-two { transform: translate(9%,8%) scale(.86); opacity: .55; }
  .mountain-three { transform: translate(-12%,17%) scale(.7); opacity: .35; }
  .contour { height: 68%; border: 1px solid rgba(239,237,227,.25); border-radius: 50% 50% 0 0; clip-path: polygon(0 60%,14% 50%,26% 65%,39% 31%,50% 42%,62% 10%,73% 45%,86% 35%,100% 67%,100% 100%,0 100%); }
  .contour-two { transform: translateY(18%) scale(.8); }
  .tool-note { position: absolute; z-index: 5; right: 28px; bottom: 24px; color: var(--pink); font-size: 13px; line-height: 1.4; transform: rotate(-4deg); }

  .chapters { display: grid; grid-template-rows: minmax(0,1.52fr) repeat(4,minmax(0,1fr)) 35px; min-width: 0; min-height: 0; height: 100%; background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper); background-blend-mode: multiply; color: var(--ink); }
  .chapter { position: relative; min-height: 0; overflow: hidden; }
  .chapter > a { position: relative; display: block; width: 100%; height: 100%; min-height: 0; color: var(--ink); isolation: isolate; }
  .chapter-art { position: absolute; z-index: -1; inset: 0 0 0 54%; overflow: hidden; background: #a5a49e; }
  .chapter-art::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle,rgba(10,10,9,.22) 0 1px,transparent 1.2px) 0 0 / 4px 4px,linear-gradient(90deg,var(--paper) 0,transparent 28%,rgba(239,237,227,.08) 100%); background-blend-mode: multiply,normal; }
  .chapter-art :global(picture), .chapter-art :global(img) { display: block; width: 100%; height: 100%; }
  .chapter-art :global(img) { object-fit: cover; filter: grayscale(1) contrast(1.45); transition: transform 500ms cubic-bezier(.2,.8,.2,1), filter 200ms ease; }
  .chapter:hover .chapter-art :global(img) { transform: scale(1.045); filter: grayscale(1) contrast(1.7); }
  .chapter-copy { position: relative; z-index: 1; width: 58%; height: 100%; padding: 13px 16px 11px 27px; display: flex; flex-direction: column; justify-content: space-between; }
  .chapter-copy::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -5px -28px -5px -8px;
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper);
    background-blend-mode: multiply;
    filter: url('#paper-tear-a') drop-shadow(1px 0 0 rgba(10,10,9,.22));
  }
  .chapter:nth-child(3n + 2) .chapter-copy::after { filter: url('#paper-tear-b') drop-shadow(1px 0 0 rgba(10,10,9,.22)); }
  .chapter:nth-child(3n) .chapter-copy::after { filter: url('#paper-tear-c') drop-shadow(1px 0 0 rgba(10,10,9,.22)); }
  .chapter-number { font: 11px/1 'VT323', monospace; letter-spacing: .06em; text-transform: uppercase; }
