---
import { Picture } from 'astro:assets';
import Html from '~/components/page/Html.astro';
import { data } from '~/data/data';
import { formatMonthYear, positionWithTeam } from '~/utils/utils.format';

const { Content, ...profile } = data.profile;
const experiences = await data.experiences.getAll();
const skills = await data.skills.getAll();
const jsonLd = await profile.getJsonLd();
---

<Html
  title={`${profile.name} — ${profile.role}`}
  description={profile.tagline ?? profile.name}
  jsonLd={jsonLd}
  themeColor="#0a0a09"
>
  <main class="about-page">
    <svg class="effect-defs" aria-hidden="true">
      <defs>
        <filter id="about-paper-tear" x="-24%" y="-8%" width="148%" height="116%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".009 .034" numOctaves="4" seed="83" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="22" xChannelSelector="G" yChannelSelector="R" />
        </filter>
        <filter id="about-paper-tear-alt" x="-24%" y="-8%" width="148%" height="116%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".013 .046" numOctaves="3" seed="31" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="17" xChannelSelector="B" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <section class="about-hero" aria-labelledby="about-title">
      <header class="hero-title">
        <p class="eyebrow">Profile / Copenhagen / Human systems</p>
        <h1 id="about-title"><span>Morten</span><strong>Olsen.</strong></h1>
        <p class="role">{profile.role}</p>
      </header>

      <div class="portrait" aria-hidden="true">
        <Picture
          src={profile.image}
          alt=""
          formats={['avif', 'webp']}
          widths={[560, 900, 1280]}
          sizes="(max-width: 760px) 100vw, 46vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="narrative">
        <div class="narrative-copy"><Content /></div>
        <div class="narrative-actions">
          <a class="download" href="/cv.pdf" download>Download print CV <span aria-hidden="true">↓</span></a>
          <nav aria-label="External profiles">
            {Object.entries(profile.profiles).map(([id, item]) => (
              <a href={item.url} target="_blank" rel="noreferrer">
                {item.network?.name || id}<span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <section class="career" aria-labelledby="career-heading">
      <header class="section-heading">
        <p>15+ years / still curious</p>
        <h2 id="career-heading"><span>Experience</span><strong>Is context.</strong></h2>
      </header>

      <div class="timeline">
        {experiences.map((experience, index) => (
          <article class="experience">
            <a href={`/experiences/${experience.id}`}>
              <div class="sequence">{String(index + 1).padStart(2, '0')}</div>
              <div class="dates">
                <span>{formatMonthYear(experience.data.startDate)}</span>
                <i aria-hidden="true">→</i>
                <span>{formatMonthYear(experience.data.endDate)}</span>
              </div>
              <div class="experience-copy">
                <div class="company-row">
                  <h3>{experience.data.company.name}</h3>
                  {experience.data.logo && (
                    <Picture
                      src={experience.data.logo}
                      alt=""
                      formats={['avif', 'webp']}
                      width={72}
                      loading="lazy"
                    />
                  )}
                </div>
                <p>{positionWithTeam(experience.data.position.name, experience.data.position.team)}</p>
                {experience.data.stack && (
                  <div class="stack">
                    {experience.data.stack.slice(0, 6).map((item) => <span>{item}</span>)}
                  </div>
                )}
              </div>
              <b class="arrow" aria-hidden="true">→</b>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="capabilities" aria-labelledby="skills-heading">
      <header>
        <p>Tools change. Judgment compounds.</p>
        <h2 id="skills-heading">Capabilities</h2>
      </header>
      <div class="skills-grid">
        {skills.map((skill, index) => (
          <article class:list={['skill', { paper: index % 3 === 1, pink: index % 3 === 2 }]}>
            <a href={`/skills/${skill.id}`}>
              <span class="skill-number">0{index + 1}</span>
              <h3>{skill.data.name}</h3>
              <div class="technologies">
                {skill.data.technologies.map((technology) => <span>{technology}</span>)}
              </div>
              <b aria-hidden="true">→</b>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Html>

<style>
  .about-page {
    --ink: #0a0a09;
    --paper: #efede3;
    --pink: #f22987;
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    background:
      linear-gradient(rgba(239,237,227,.045) 1px, transparent 1px) 0 0 / 46px 46px,
      linear-gradient(90deg, rgba(239,237,227,.045) 1px, transparent 1px) 0 0 / 46px 46px,
      var(--ink);
    color: var(--paper);
  }

  .effect-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .about-hero {
    display: grid;
    grid-template: minmax(380px, 54svh) auto / minmax(0, 58%) minmax(340px, 42%);
    min-height: calc(100svh - 64px);
  }
  .hero-title {
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(30px, 5vw, 76px);
  }
  .eyebrow, .role, .section-heading > p, .capabilities > header p {
    font-family: 'VT323', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .eyebrow { color: var(--pink); font-size: 14px; }
  h1 {
    margin: 0;
    font: 400 clamp(6rem, 12vw, 13rem)/.7 'Archivo Black', sans-serif;
    letter-spacing: -.075em;
    text-transform: uppercase;
  }
  h1 span, h1 strong { display: block; }
  h1 span { width: max-content; font-family: 'Archivo Narrow', sans-serif; font-weight: 700; letter-spacing: -.035em; transform: scaleX(.9); transform-origin: left; }
  h1 strong { color: var(--pink); font-weight: 400; }
  .role { color: #aaa79d; font-size: 14px; }

  .portrait { position: relative; grid-area: 1 / 2 / 3; min-height: 720px; overflow: hidden; background: #333; }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, rgba(10,10,9,.22) 0 1px, transparent 1.2px) 0 0 / 4px 4px,
      linear-gradient(90deg, var(--ink) 0, transparent 32%, transparent 72%, rgba(10,10,9,.42));
    background-blend-mode: multiply;
  }
  .portrait :global(picture), .portrait :global(img) { display: block; width: 100%; height: 100%; }
  .portrait :global(img) { object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.3); }

  .narrative {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(30px, 5vw, 80px);
    padding: clamp(34px, 5vw, 72px);
    isolation: isolate;
    color: var(--ink);
  }
  .narrative::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18px -36px -12px -12px;
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper);
    background-blend-mode: multiply;
    filter: url('#about-paper-tear') drop-shadow(2px 0 rgba(10,10,9,.28));
  }
  .narrative-copy { max-width: 68ch; }
  .narrative-copy :global(p) { margin: 0 0 1em; font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.45; }
  .narrative-copy :global(p:last-child) { margin-bottom: 0; }
  .narrative-actions { display: flex; flex-direction: column; justify-content: space-between; gap: 28px; min-width: 180px; }
  .narrative-actions a { display: flex; justify-content: space-between; gap: 18px; padding-bottom: 7px; border-bottom: 1px solid rgba(10,10,9,.42); font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .narrative-actions nav { display: grid; gap: 10px; }
  .narrative-actions span { color: var(--pink); }

  .career { padding: clamp(64px, 8vw, 128px) clamp(20px, 5vw, 82px); }
  .section-heading { display: grid; grid-template-columns: 1fr 2.2fr; align-items: end; gap: 32px; margin-bottom: clamp(44px, 6vw, 90px); }
  .section-heading > p { color: #aaa79d; font-size: 13px; }
  .section-heading h2 { margin: 0; font: 400 clamp(4.2rem, 8vw, 9rem)/.72 'Archivo Black', sans-serif; letter-spacing: -.07em; text-transform: uppercase; }
  .section-heading h2 span, .section-heading h2 strong { display: block; }
  .section-heading h2 span { font-family: 'Archivo Narrow', sans-serif; font-weight: 700; }
  .section-heading h2 strong { color: var(--pink); font-weight: 400; }

  .timeline { display: grid; gap: 20px; }
  .experience { position: relative; min-height: 190px; isolation: isolate; }
  .experience:nth-child(even) { color: var(--ink); }
  .experience:nth-child(even)::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -5px -8px;
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper);
    background-blend-mode: multiply;
    filter: url('#about-paper-tear-alt') drop-shadow(2px 0 rgba(10,10,9,.25));
  }
  .experience > a {
    display: grid;
    grid-template-columns: 70px 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 64px);
    min-height: inherit;
    padding: 28px clamp(18px, 3vw, 44px);
    color: inherit;
  }
  .sequence { color: var(--pink); font: 3rem/1 'Archivo Black', sans-serif; }
  .dates { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; font: 12px 'VT323', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .dates i { grid-area: 1 / 2 / 3; align-self: center; color: var(--pink); font-style: normal; }
  .experience-copy { min-width: 0; }
  .company-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .company-row h3 { margin: 0; font: 400 clamp(2.2rem, 4vw, 4.8rem)/.8 'Archivo Black', sans-serif; letter-spacing: -.06em; text-transform: uppercase; }
  .company-row :global(picture), .company-row :global(img) { display: block; max-width: 72px; max-height: 46px; object-fit: contain; filter: grayscale(1) contrast(1.4); }
  .experience-copy > p { margin: 10px 0 18px; font-size: clamp(1rem, 1.4vw, 1.25rem); }
  .stack { display: flex; flex-wrap: wrap; gap: 7px; }
  .stack span { padding: 4px 7px; background: rgba(239,237,227,.1); color: #aaa79d; font: 11px 'VT323', monospace; letter-spacing: .04em; text-transform: uppercase; }
  .experience:nth-child(even) .stack span { background: rgba(10,10,9,.08); color: #55534e; }
  .arrow { color: var(--pink); font: 2rem/1 'Space Grotesk', sans-serif; }

  .capabilities { padding: clamp(54px, 7vw, 110px) clamp(20px, 5vw, 82px) clamp(80px, 9vw, 150px); }
  .capabilities > header { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .capabilities > header p { max-width: 25ch; color: #aaa79d; font-size: 13px; }
  .capabilities > header h2 { margin: 0; color: var(--pink); font: 400 clamp(4rem, 8vw, 8rem)/.75 'Archivo Black', sans-serif; letter-spacing: -.07em; text-transform: uppercase; }
  .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .skill { position: relative; min-height: 340px; overflow: hidden; background: #171716; }
  .skill.paper { isolation: isolate; color: var(--ink); background: transparent; overflow: visible; }
  .skill.paper::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -6px;
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, var(--paper);
    background-blend-mode: multiply;
    filter: url('#about-paper-tear');
  }
  .skill.pink { color: var(--ink); background: var(--pink); }
  .skill > a { position: relative; display: flex; flex-direction: column; min-height: inherit; padding: clamp(24px, 4vw, 48px); color: inherit; }
  .skill-number { color: var(--pink); font: 13px 'VT323', monospace; }
  .pink .skill-number { color: var(--ink); }
  .skill h3 { max-width: 12ch; margin: auto 0 24px; font: 400 clamp(2.5rem, 5vw, 5.8rem)/.8 'Archivo Black', sans-serif; letter-spacing: -.06em; text-transform: uppercase; }
  .technologies { display: flex; flex-wrap: wrap; gap: 8px; max-width: 80%; }
  .technologies span { color: #aaa79d; font: 12px 'VT323', monospace; letter-spacing: .04em; text-transform: uppercase; }
  .paper .technologies span, .pink .technologies span { color: #45443f; }
  .skill b { position: absolute; right: 34px; bottom: 30px; color: var(--pink); font-size: 24px; }
  .pink b { color: var(--ink); }

  @media (max-width: 900px) {
    .about-hero { grid-template: auto 560px auto / 1fr; }
    .hero-title { min-height: 390px; }
    .portrait { grid-area: 2 / 1; min-height: 560px; }
    .portrait::after { background: linear-gradient(0deg, var(--ink), transparent 35%); }
    .narrative { grid-area: 3 / 1; }
    .narrative::before { inset: -18px -10px -12px; }
    .section-heading { grid-template-columns: 1fr; }
    .experience > a { grid-template-columns: 56px 120px 1fr auto; gap: 20px; }
  }

  @media (max-width: 650px) {
    .hero-title { min-height: 330px; padding: 28px 20px; }
    h1 { font-size: clamp(5.2rem, 25vw, 8rem); }
    .about-hero { grid-template-rows: auto 430px auto; }
    .portrait { min-height: 430px; }
    .narrative { display: block; padding: 40px 24px; }
    .narrative-actions { margin-top: 34px; }
    .career { padding-inline: 14px; }
    .section-heading h2 { font-size: clamp(4rem, 19vw, 6rem); }
    .experience { min-height: 330px; }
    .experience > a { grid-template-columns: 48px 1fr; align-items: start; gap: 18px; padding: 28px 18px; }
    .dates { grid-column: 2; }
    .experience-copy { grid-column: 1 / -1; }
    .arrow { position: absolute; right: 20px; bottom: 22px; }
    .company-row h3 { font-size: clamp(2.4rem, 13vw, 4rem); }
    .capabilities { padding-inline: 14px; }
    .capabilities > header { align-items: flex-start; flex-direction: column; }
    .capabilities > header h2 { font-size: clamp(3.4rem, 16vw, 5.2rem); }
    .skills-grid { display: block; }
    .skill { min-height: 360px; margin-bottom: 16px; }
  }
</style>
