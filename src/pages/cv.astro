---
import Html from "~/components/page/Html.astro";
import { data } from "~/data/data";
import { formatMonthYear, positionWithTeam } from "~/utils/utils.format";

const { Content, ...profile } = data.profile;
const experiences = await data.experiences.getAll();
const skills = await data.skills.getAll();
const jsonLd = await profile.getJsonLd();
const generatedAt = new Date();
---

<Html
  title={`CV — ${profile.name}`}
  description={`A print-optimized CV for ${profile.name}`}
  jsonLd={jsonLd}
>
  <main class="page-shell">
    <div class="actions" aria-label="CV actions">
      <a class="button primary" href="/cv.pdf" download>Download PDF</a>
      <button class="button" type="button" onclick="window.print()">Print this version</button>
    </div>

    <article class="cv-sheet" aria-label={`CV for ${profile.name}`}>
      <div class="spine" aria-hidden="true">CV / {generatedAt.getFullYear()}</div>

      <header class="hero">
        <div class="identity">
          <p class="eyebrow">Print edition · Copenhagen</p>
          <h1>{profile.name}</h1>
          <p class="role">{profile.role ?? 'Senior Software Engineer'}</p>
        </div>
        <address class="contact">
          <a href={profile.url}>{profile.url.replace(/^https?:\/\//, '')}</a>
          {Object.values(profile.profiles).map((item) => (
            <a href={item.url}>{item.network?.name || item.username || item.url.replace(/^https?:\/\//, '')}</a>
          ))}
        </address>
      </header>

      <section class="manifesto" aria-label="Profile summary">
        <p>{profile.tagline}</p>
      </section>

      <div class="content-grid">
        <section class="experience-section" aria-labelledby="experience-title">
          <div class="section-heading">
            <span>01</span>
            <h2 id="experience-title">Experience</h2>
          </div>
          <div class="timeline">
            {experiences.map((experience) => (
              <article class="experience">
                <div class="dates">
                  <span>{formatMonthYear(experience.data.startDate)}</span>
                  <span>{experience.data.endDate ? formatMonthYear(experience.data.endDate) : 'Present'}</span>
                </div>
                <div class="entry">
                  <div class="entry-title">
                    <h3>{experience.data.company.name}</h3>
                    <p>{positionWithTeam(experience.data.position.name, experience.data.position.team)}</p>
                  </div>
                  {experience.data.summary && !experience.data.summary.includes('TODO') && (
                    <p class="entry-summary">{experience.data.summary}</p>
                  )}
                  {experience.data.stack && (
                    <ul class="stack" aria-label="Technology stack">
                      {experience.data.stack.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <aside class="side-panel" aria-labelledby="skills-title">
          <section>
            <div class="section-heading compact">
              <span>02</span>
              <h2 id="skills-title">Skills</h2>
            </div>
            {skills.map((skill) => (
              <div class="skill-group">
                <h3>{skill.data.name}</h3>
                <p>{skill.data.technologies.join(' · ')}</p>
              </div>
            ))}
          </section>

          <section class="profile-copy">
            <div class="section-heading compact">
              <span>03</span>
              <h2>Voice</h2>
            </div>
            <Content />
          </section>

          <section class="meta">
            <a href="/cv.pdf" download>PDF</a>
            <a href="/resume.json">JSON Resume</a>
            <p>Generated {generatedAt.getFullYear()}</p>
          </section>
        </aside>
      </div>
    </article>
  </main>
</Html>

<style>
  .page-shell {
    --paper: #fffdf8;
    --ink: #111;
    --muted: #555;
    --faint: #dedbd2;
    max-width: 1040px;
    margin: 0 auto;
    padding: calc(var(--gap) * 2) 24px calc(var(--gap) * 4);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-bottom: 18px;
  }

  .button {
    border: 2px solid var(--border-color);
    background: var(--card-bg);
    box-shadow: 4px 4px 0 var(--border-color);
    color: var(--t-fg);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 10px 16px;
    text-transform: uppercase;
  }

  .button.primary {
    background: var(--t-fg);
    color: var(--c-bg);
  }

  .cv-sheet {
    background:
      linear-gradient(90deg, transparent 0 55px, var(--ink) 55px 57px, transparent 57px),
      linear-gradient(var(--faint) 1px, transparent 1px),
      var(--paper);
    background-size: auto, 100% 11px, auto;
    border: 1px solid var(--ink);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22);
    color: var(--ink);
    display: grid;
    grid-template-columns: 58px 1fr;
    min-height: 1200px;
  }

  .spine {
    align-items: center;
    border-right: 1px solid var(--ink);
    display: flex;
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    justify-content: center;
    letter-spacing: 0.22em;
    min-height: 100%;
    text-orientation: mixed;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .hero,
  .manifesto,
  .content-grid {
    grid-column: 2;
  }

  .hero {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr 230px;
    padding: 48px 48px 28px;
  }

  .eyebrow {
    border-bottom: 1px solid var(--ink);
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 18px;
    padding-bottom: 5px;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-family-display);
    font-size: clamp(4rem, 10vw, 8.4rem);
    letter-spacing: -0.07em;
    line-height: 0.76;
    margin: 0;
    max-width: 720px;
    text-transform: uppercase;
  }

  .role {
    font-family: var(--font-family-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 22px 0 0;
    text-transform: uppercase;
  }

  .contact {
    align-self: start;
    border-left: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    font-style: normal;
    gap: 8px;
    padding-left: 18px;
  }

  .contact a,
  .meta a {
    color: var(--ink);
    font-family: var(--font-family-mono);
    font-size: 0.86rem;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact a::before,
  .meta a::before {
    content: "↗ ";
  }

  .manifesto {
    border-bottom: 2px solid var(--ink);
    border-top: 6px solid var(--ink);
    margin: 0 48px 34px;
    padding: 20px 0 22px;
  }

  .manifesto p {
    font-family: var(--font-family-display);
    font-size: clamp(1.5rem, 3.2vw, 2.35rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
  }

  .content-grid {
    display: grid;
    gap: 38px;
    grid-template-columns: 1fr 265px;
    padding: 0 48px 48px;
  }

  .section-heading {
    align-items: baseline;
    display: grid;
    gap: 14px;
    grid-template-columns: 36px 1fr;
    margin-bottom: 18px;
  }

  .section-heading span {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  h2 {
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-family-display);
    font-size: 2rem;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    padding-bottom: 8px;
    text-transform: uppercase;
  }

  .section-heading.compact {
    grid-template-columns: 28px 1fr;
    margin-bottom: 14px;
  }

  .section-heading.compact h2 {
    font-size: 1.55rem;
  }

  .timeline {
    display: grid;
    gap: 20px;
  }

  .experience {
    display: grid;
    gap: 18px;
    grid-template-columns: 108px 1fr;
    page-break-inside: avoid;
  }

  .dates {
    color: var(--muted);
    display: flex;
    flex-direction: column;
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .dates span:first-child::after {
    content: " ↓";
  }

  .entry {
    border-left: 1px solid var(--ink);
    padding-left: 18px;
  }

  .entry-title {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }

  .entry h3,
  .skill-group h3 {
    font-family: var(--font-family-display);
    font-size: 1.38rem;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  .entry-title p {
    font-weight: 700;
    margin: 0;
  }

  .entry-summary {
    color: var(--muted);
    line-height: 1.48;
    margin: 8px 0 10px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .stack li {
    border: 1px solid var(--ink);
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 6px;
  }

  .side-panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .skill-group {
    border-bottom: 1px solid var(--ink);
    margin-bottom: 13px;
    padding-bottom: 13px;
    page-break-inside: avoid;
  }

  .skill-group p,
  .profile-copy :global(p),
  .meta p {
    color: var(--muted);
    line-height: 1.45;
    margin: 7px 0 0;
  }

  .profile-copy :global(p:nth-of-type(n + 2)) {
    display: none;
  }

  .meta {
    border: 1px solid var(--ink);
    margin-top: auto;
    padding: 14px;
  }

  .meta a {
    display: block;
    margin-bottom: 8px;
  }

  @media (max-width: 860px) {
    .cv-sheet {
      grid-template-columns: 1fr;
    }

    .spine {
      display: none;
    }

    .hero,
    .manifesto,
    .content-grid {
      grid-column: 1;
    }

    .hero,
    .content-grid,
    .experience {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    @page {
      margin: 11mm;
      size: A4;
    }

    .page-shell {
      background: white;
      max-width: none;
      padding: 0;
    }

    .actions,
    :global(.theme-toggle-fixed),
    :global(.scanlines),
    :global(.grain-overlay) {
      display: none !important;
    }

    .cv-sheet {
      background: white;
      border: 0;
      box-shadow: none;
      grid-template-columns: 34pt 1fr;
      min-height: 0;
    }

    .spine {
      border-right: 0.5pt solid #000;
      font-size: 6.5pt;
    }

    .hero {
      gap: 16pt;
      grid-template-columns: 1fr 128pt;
      padding: 0 0 12pt 16pt;
    }

    .eyebrow {
      font-size: 6.5pt;
      margin-bottom: 9pt;
    }

    h1 {
      font-size: 44pt;
    }

    .role,
    .contact a,
    .meta a {
      font-size: 7.2pt;
    }

    .manifesto {
      border-bottom: 1pt solid #000;
      border-top: 3pt solid #000;
      margin: 0 0 14pt 16pt;
      padding: 8pt 0 10pt;
    }

    .manifesto p {
      font-size: 16pt;
      line-height: 1.05;
    }

    .content-grid {
      gap: 18pt;
      grid-template-columns: 1fr 132pt;
      padding: 0 0 0 16pt;
    }

    .section-heading {
      gap: 7pt;
      grid-template-columns: 18pt 1fr;
      margin-bottom: 9pt;
    }

    h2 {
      font-size: 14pt;
      padding-bottom: 4pt;
    }

    .section-heading.compact h2 {
      font-size: 12pt;
    }

    .timeline {
      gap: 9pt;
    }

    .experience {
      gap: 8pt;
      grid-template-columns: 51pt 1fr;
    }

    .dates,
    .stack li,
    .section-heading span {
      font-size: 6.1pt;
    }

    .entry {
      padding-left: 8pt;
    }

    .entry h3,
    .skill-group h3 {
      font-size: 9.6pt;
    }

    .entry-title p,
    .entry-summary,
    .skill-group p,
    .profile-copy :global(p),
    .meta p {
      font-size: 7.2pt;
      line-height: 1.32;
    }

    .stack {
      gap: 3pt;
      margin-top: 5pt;
    }

    .stack li {
      padding: 1pt 3pt;
    }

    .skill-group {
      margin-bottom: 7pt;
      padding-bottom: 7pt;
    }

    .profile-copy {
      display: none;
    }
  }
</style>
