---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Html from '~/components/page/Html.astro';
import { data } from '~/data/data';

export const getStaticPaths = (async () => {
  const projects = await data.projects.getAll();
  return projects.map((project) => ({ params: { id: project.id } }));
}) satisfies GetStaticPaths;

const project = await data.projects.get(Astro.params.id);
const { Content } = await render(project);
---

<Html title={project.data.name} description={project.data.description}>
  <main class="project-detail">
    <svg class="filters" aria-hidden="true">
      <filter id="project-paper-tear" x="-4%" y="-4%" width="108%" height="108%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.035" numOctaves="3" seed="43" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="12" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="project-hero">
      <div class="hero-art" aria-hidden="true">
        {project.data.heroImage ? (
          <Picture
            src={project.data.heroImage}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600]}
            sizes="(max-width: 800px) 100vw, 52vw"
            loading="eager"
          />
        ) : (
          <div class="signal-art">
            <i></i><i></i><i></i><i></i>
            <b>SYS</b>
          </div>
        )}
      </div>

      <div class="hero-copy">
        <a href="/projects/" class="back-link">← Project archive</a>
        <p class="eyebrow">Open system / project file</p>
        <h1>{project.data.name}</h1>
        <p class="description">{project.data.description}</p>
        <div class="hero-meta">
          {project.data.status && <span class="status">{project.data.status}</span>}
          <span>{String(project.data.stack.length).padStart(2, '0')} components</span>
        </div>
      </div>
    </header>

    <section class="system-strip" aria-label="Technology stack">
      <p>System vocabulary</p>
      <div class="technologies">
        {project.data.stack.map((tech: string) => <span>{tech}</span>)}
      </div>
    </section>

    <section class="paper-sheet">
      <aside class="project-actions">
        <p>Inspect the system</p>
        <a href={project.data.repo} target="_blank" rel="noreferrer">Source / GitHub <span>↗</span></a>
        {project.data.url && (
          <a href={project.data.url} target="_blank" rel="noreferrer">Live system <span>↗</span></a>
        )}
      </aside>
      <div class="content">
        <Content />
      </div>
    </section>

    <footer class="detail-footer">
      <p>Small tools. Bigger questions.</p>
      <a href="/projects/">All working systems <span>→</span></a>
    </footer>
  </main>
</Html>

<style>
  .project-detail {
    --ink: #0a0a09;
    --paper: #efede3;
    --pink: #f22987;
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px,
      linear-gradient(90deg, rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px,
      var(--ink);
    color: var(--paper);
  }
  .filters { position: absolute; width: 0; height: 0; }
  .project-hero { display: grid; grid-template-columns: 1.05fr .95fr; min-height: 690px; border-bottom: 1px solid rgba(239,237,227,.35); }
  .hero-art { position: relative; min-height: 620px; overflow: hidden; border-right: 1px solid rgba(239,237,227,.35); background: #232321; }
  .hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, rgba(239,237,227,.18) 0 1px, transparent 1.3px) 0 0 / 4px 4px,
      linear-gradient(90deg, rgba(10,10,9,.15), rgba(10,10,9,.7));
    pointer-events: none;
  }
  .hero-art :global(picture), .hero-art :global(img) { width: 100%; height: 100%; }
  .hero-art :global(img) { display: block; object-fit: cover; filter: grayscale(1) contrast(1.35); }
  .signal-art { position: absolute; inset: 0; overflow: hidden; background: repeating-radial-gradient(circle at 45% 52%, transparent 0 54px, rgba(239,237,227,.16) 55px 56px), linear-gradient(135deg, #151514, #55524c); }
  .signal-art::before, .signal-art::after { content: ''; position: absolute; background: var(--pink); }
  .signal-art::before { top: 52%; left: 0; width: 100%; height: 2px; transform: rotate(-11deg); }
  .signal-art::after { top: 0; left: 45%; width: 2px; height: 100%; transform: rotate(7deg); }
  .signal-art i { position: absolute; left: 12%; width: 76%; height: 1px; background: rgba(239,237,227,.22); transform: rotate(-7deg); }
  .signal-art i:nth-child(1) { top: 22%; } .signal-art i:nth-child(2) { top: 39%; transform: rotate(-2deg); }
  .signal-art i:nth-child(3) { top: 61%; transform: rotate(3deg); } .signal-art i:nth-child(4) { top: 78%; transform: rotate(8deg); }
  .signal-art b { position: absolute; right: -2%; bottom: -10%; color: rgba(239,237,227,.18); font: 400 clamp(12rem, 28vw, 34rem)/.7 'Archivo Black', sans-serif; letter-spacing: -.08em; }
  .hero-copy { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(34px, 6vw, 94px); }
  .back-link { position: absolute; top: 100px; color: var(--paper); font: 13px 'VT323', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .back-link:hover { color: var(--pink); }
  .eyebrow, .hero-meta, .system-strip p, .project-actions p, .technologies, .detail-footer { font-family: 'VT323', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 22px; color: var(--pink); font-size: 14px; }
  h1 { max-width: 11ch; margin: 0; font: 700 clamp(4.4rem, 7.5vw, 9rem)/.76 'Archivo Narrow', sans-serif; letter-spacing: -.045em; overflow-wrap: normal; word-break: normal; text-transform: uppercase; }
  .description { max-width: 38ch; margin: 34px 0; font-size: clamp(1.15rem, 1.7vw, 1.55rem); line-height: 1.2; }
  .hero-meta { display: flex; align-items: center; gap: 18px; color: #aaa79d; font-size: 13px; }
  .status { padding: 7px 12px; background: var(--pink); color: var(--ink); }
  .system-strip { display: grid; grid-template-columns: 220px 1fr; align-items: start; gap: 30px; padding: 30px clamp(22px, 5vw, 82px); border-bottom: 1px solid rgba(239,237,227,.35); }
  .system-strip p { margin: 4px 0 0; color: var(--pink); font-size: 13px; }
  .technologies { display: flex; flex-wrap: wrap; gap: 8px; }
  .technologies span { padding: 5px 9px; background: rgba(239,237,227,.1); color: #cbc8bf; font-size: 12px; }
  .paper-sheet { position: relative; z-index: 0; isolation: isolate; display: grid; grid-template-columns: minmax(190px, .35fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 100px); max-width: 1240px; margin: clamp(70px, 9vw, 150px) auto; padding: clamp(54px, 8vw, 112px); color: var(--ink); }
  .paper-sheet::before { content: ''; position: absolute; z-index: -1; inset: 0; filter: url('#project-paper-tear'); background: var(--paper) url('/paper-grain.webp') 0 0 / 192px 192px repeat; }
  .project-actions { align-self: start; position: sticky; top: 94px; }
  .project-actions p { margin: 0 0 26px; color: var(--pink); font-size: 13px; }
  .project-actions a { display: flex; justify-content: space-between; gap: 20px; padding: 13px 0; border-bottom: 1px solid rgba(10,10,9,.35); color: var(--ink); font: 700 13px 'Archivo Narrow', sans-serif; letter-spacing: .04em; text-transform: uppercase; }
  .project-actions span, .detail-footer span { color: var(--pink); }
  .content { min-width: 0; font: 1.08rem/1.75 'Space Grotesk', sans-serif; }
  .content :global(p), .content :global(ul), .content :global(ol) { margin: 0 0 1.6em; }
  .content :global(h2) { margin: 2.1em 0 .65em; color: var(--pink); font: 400 clamp(2.2rem, 4.5vw, 4.8rem)/.86 'Archivo Black', sans-serif; letter-spacing: -.055em; text-transform: uppercase; }
  .content :global(h2:first-child) { margin-top: 0; }
  .content :global(h3) { margin: 2em 0 .6em; font: 700 1.5rem 'Archivo Narrow', sans-serif; text-transform: uppercase; }
  .content :global(ul), .content :global(ol) { padding-left: 1.3em; }
  .content :global(li) { margin: .5em 0; }
  .content :global(li::marker) { color: var(--pink); }
  .content :global(a) { text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .content :global(code) { padding: 2px 5px; background: rgba(10,10,9,.09); }
  .content :global(pre) { max-width: 100%; overflow-x: auto; padding: 22px; background: var(--ink); color: var(--paper); }
  .content :global(img) { max-width: 100%; filter: grayscale(1) contrast(1.15); }
  .detail-footer { display: flex; justify-content: space-between; gap: 30px; padding: 30px clamp(22px, 5vw, 82px); border-top: 1px solid rgba(239,237,227,.35); color: #aaa79d; font-size: 13px; }
  .detail-footer a { color: var(--paper); }

  @media (max-width: 800px) {
    .project-hero { display: flex; flex-direction: column; min-height: 0; }
    .hero-art { min-height: 390px; border-right: 0; border-bottom: 1px solid rgba(239,237,227,.35); }
    .hero-copy { min-height: 500px; padding: 46px 20px 54px; }
    .back-link { position: static; order: -1; margin-bottom: auto; }
    h1 { font-size: clamp(4.1rem, 19vw, 7rem); }
    .description { margin: 26px 0; }
    .system-strip { grid-template-columns: 1fr; gap: 18px; padding: 28px 20px; }
    .paper-sheet { display: block; width: calc(100% - 20px); margin: 64px 10px; padding: 52px 26px; }
    .project-actions { position: static; margin-bottom: 58px; }
    .content { font-size: 1rem; }
    .detail-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
