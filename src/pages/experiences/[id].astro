---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Html from '~/components/page/Html.astro';
import { data } from '~/data/data';
import { formatMonthYear, positionWithTeam } from '~/utils/utils.format';

export const getStaticPaths = (async () => {
  const experiences = await data.experiences.getAll();
  return experiences.map((experience) => ({ params: { id: experience.id } }));
}) satisfies GetStaticPaths;

const experience = await data.experiences.get(Astro.params.id);
const { Content } = await render(experience);
const position = positionWithTeam(experience.data.position.name, experience.data.position.team);
---

<Html title={`${position} at ${experience.data.company.name}`} description={`${position} at ${experience.data.company.name}`}>
  <main class="position-detail">
    <svg class="filters" aria-hidden="true">
      <filter id="position-paper-tear" x="-4%" y="-4%" width="108%" height="108%">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.04" numOctaves="3" seed="29" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="11" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="position-hero">
      <div class="hero-rail">
        <a href="/about/">← Experience archive</a>
        <span>Career record / Copenhagen</span>
      </div>
      <div class="hero-main">
        <div class="identity">
          <p>Position / context</p>
          <h1>{experience.data.company.name}</h1>
          <h2>{position}</h2>
        </div>
        <aside class="date-panel">
          <div class="logo-field">
            {experience.data.logo ? (
              <Picture
                src={experience.data.logo}
                alt={`${experience.data.company.name} logo`}
                formats={['avif', 'webp']}
                width={180}
                loading="eager"
              />
            ) : <span>{experience.data.company.name.charAt(0)}</span>}
          </div>
          <div class="dates">
            <span>{formatMonthYear(experience.data.startDate)}</span>
            <i aria-hidden="true">→</i>
            <span>{formatMonthYear(experience.data.endDate)}</span>
          </div>
        </aside>
      </div>
    </header>

    {experience.data.stack && experience.data.stack.length > 0 && (
      <section class="stack-strip" aria-label="Technology stack">
        <p>Working set</p>
        <div>{experience.data.stack.map((item) => <span>{item}</span>)}</div>
      </section>
    )}

    <section class="paper-record">
      <aside>
        <span class="record-number">REC</span>
        <p>Experience is never a list of tools. It is the context, decisions, and people around them.</p>
      </aside>
      <div class="content"><Content /></div>
    </section>

    <footer class="detail-footer">
      <p>One chapter in a longer system.</p>
      <a href="/about/">Full experience timeline <span>→</span></a>
    </footer>
  </main>
</Html>

<style>
  .position-detail {
    --ink: #0a0a09; --paper: #efede3; --pink: #f22987;
    min-height: 100vh; overflow: hidden;
    background: linear-gradient(rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px, linear-gradient(90deg, rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px, var(--ink);
    color: var(--paper);
  }
  .filters { position: absolute; width: 0; height: 0; }
  .position-hero { min-height: 690px; border-bottom: 1px solid rgba(239,237,227,.35); }
  .hero-rail { display: flex; justify-content: space-between; gap: 30px; padding: 32px clamp(22px, 5vw, 82px); border-bottom: 1px solid rgba(239,237,227,.35); color: #aaa79d; font: 13px 'VT323', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .hero-rail a { color: var(--paper); } .hero-rail a:hover { color: var(--pink); }
  .hero-main { display: grid; grid-template-columns: 1fr minmax(360px, .42fr); min-height: 620px; }
  .identity { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(44px, 7vw, 108px) clamp(22px, 5vw, 82px); border-right: 1px solid rgba(239,237,227,.35); }
  .identity > p { margin: 0 0 24px; color: var(--pink); font: 14px 'VT323', monospace; letter-spacing: .09em; text-transform: uppercase; }
  h1 { width: max-content; max-width: none; margin: 0; font: 700 clamp(5rem, 9vw, 10rem)/.73 'Archivo Narrow', sans-serif; letter-spacing: -.045em; white-space: nowrap; text-transform: uppercase; }
  h2 { max-width: 32ch; margin: 34px 0 0; font: 700 clamp(1.35rem, 2vw, 2rem)/1.1 'Archivo Narrow', sans-serif; letter-spacing: .02em; text-transform: uppercase; }
  .date-panel { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(38px, 5vw, 74px); }
  .logo-field { position: relative; display: grid; place-items: center; aspect-ratio: 1; overflow: hidden; background: var(--paper); transform: rotate(2deg); }
  .logo-field::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, rgba(10,10,9,.2) 0 1px, transparent 1.3px) 0 0 / 4px 4px; mix-blend-mode: multiply; }
  .logo-field :global(picture), .logo-field :global(img) { max-width: 72%; max-height: 72%; }
  .logo-field :global(img) { object-fit: contain; filter: grayscale(1) contrast(1.4); }
  .logo-field > span { color: var(--ink); font: 400 9rem/.7 'Archivo Black', sans-serif; }
  .dates { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin-top: 44px; color: #cbc8bf; font: 13px 'VT323', monospace; letter-spacing: .07em; text-transform: uppercase; }
  .dates span:last-child { text-align: right; } .dates i { color: var(--pink); font: 20px 'Space Grotesk', sans-serif; }
  .stack-strip { display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 30px clamp(22px, 5vw, 82px); border-bottom: 1px solid rgba(239,237,227,.35); }
  .stack-strip p { margin: 4px 0 0; color: var(--pink); font: 13px 'VT323', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .stack-strip div { display: flex; flex-wrap: wrap; gap: 8px; }
  .stack-strip span { padding: 5px 9px; background: rgba(239,237,227,.1); color: #cbc8bf; font: 12px 'VT323', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .paper-record { position: relative; z-index: 0; isolation: isolate; display: grid; grid-template-columns: minmax(180px, .35fr) minmax(0, 1fr); gap: clamp(30px, 7vw, 110px); max-width: 1180px; margin: clamp(70px, 9vw, 150px) auto; padding: clamp(52px, 8vw, 110px); color: var(--ink); }
  .paper-record::before { content: ''; position: absolute; z-index: -1; inset: 0; filter: url('#position-paper-tear'); background: var(--paper) url('/paper-grain.webp') 0 0 / 192px 192px repeat; }
  .paper-record aside { border-top: 2px solid var(--ink); }
  .record-number { display: block; margin: 18px 0 70px; color: var(--pink); font: 400 clamp(4rem, 7vw, 7rem)/.8 'Archivo Black', sans-serif; letter-spacing: -.08em; }
  .paper-record aside p { max-width: 23ch; font: 700 1.25rem/1.15 'Archivo Narrow', sans-serif; text-transform: uppercase; }
  .content { min-width: 0; font: 1.08rem/1.75 'Space Grotesk', sans-serif; }
  .content :global(p), .content :global(ul), .content :global(ol) { margin: 0 0 1.6em; }
  .content :global(h2) { margin: 2.1em 0 .65em; color: var(--pink); font: 400 clamp(2.2rem, 4.4vw, 4.6rem)/.86 'Archivo Black', sans-serif; letter-spacing: -.055em; text-transform: uppercase; }
  .content :global(h2:first-child) { margin-top: 0; }
  .content :global(h3) { margin: 2em 0 .6em; font: 700 1.5rem 'Archivo Narrow', sans-serif; text-transform: uppercase; }
  .content :global(ul), .content :global(ol) { padding-left: 1.3em; }
  .content :global(li) { margin: .5em 0; } .content :global(li::marker) { color: var(--pink); }
  .content :global(a) { text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .detail-footer { display: flex; justify-content: space-between; gap: 30px; padding: 30px clamp(22px, 5vw, 82px); border-top: 1px solid rgba(239,237,227,.35); color: #aaa79d; font: 13px 'VT323', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .detail-footer a { color: var(--paper); } .detail-footer span { color: var(--pink); }
  @media (max-width: 800px) {
    .position-hero { min-height: 0; } .hero-rail { padding: 24px 20px; } .hero-rail span { display: none; }
    .hero-main { display: flex; flex-direction: column; min-height: 0; }
    .identity { min-height: 470px; padding: 48px 20px; border-right: 0; border-bottom: 1px solid rgba(239,237,227,.35); }
    h1 { width: 122%; font-size: clamp(4rem, 19vw, 7rem); transform: scaleX(.82); transform-origin: left; } h2 { margin-top: 26px; }
    .date-panel { padding: 28px 20px 38px; } .logo-field { max-height: 330px; } .dates { margin-top: 28px; }
    .stack-strip { grid-template-columns: 1fr; gap: 18px; padding: 28px 20px; }
    .paper-record { display: block; width: calc(100% - 20px); margin: 64px 10px; padding: 52px 26px; }
    .paper-record aside { margin-bottom: 60px; } .record-number { margin-bottom: 32px; } .content { font-size: 1rem; }
    .detail-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
