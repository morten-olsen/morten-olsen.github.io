---
import Html from '~/components/page/Html.astro';
import type { GetStaticPaths } from "astro";
import { renderPost } from '~/utils/render-post';
import { data } from '~/data/data'
import { Picture } from 'astro:assets';
import AbsoluteTime from '~/components/base/time/AbsoluteTime.astro';

export const getStaticPaths = (async () => {
  const posts = await data.posts.getAll();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      prevPost: posts[index + 1] || null,
      nextPost: posts[index - 1] || null,
    }
  }));
}) satisfies GetStaticPaths;

const { prevPost, nextPost } = Astro.props;
const post = await data.posts.get(Astro.params.id);
const siteUrl = Astro.site?.toString() ?? 'http://localhost:4321/';
const { html, headings } = await renderPost(post, { siteUrl });
const tocHeadings = headings.filter(h => h.depth === 2);
const hasToC = tocHeadings.length >= 3;
---

<Html
  title={post.data.title}
  description={post.data.description}
  jsonLd={post.jsonLd}
  image={`/posts/${post.id}/share.png`}
  type="article"
  showTexture={false}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  author={data.profile.name}
  tags={post.data.tags}
>

  <article>
    <svg class="filters" aria-hidden="true">
      <filter id="article-paper-tear" x="-3%" y="-2%" width="106%" height="104%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.035" numOctaves="3" seed="53" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <div class="hero-image anim-hero" data-parallax-bg>
      <Picture
        loading='eager'
        class='img'
        fetchpriority="high"
        src={post.data.heroImage}
        widths={[320, 640, 1024, 1400]}
        formats={['avif', 'webp', 'png']}
        alt='Cover image'
      />
    </div>
    <div class="article-container">
      <header>
        <a href="/posts/" class="back-link">← Writing archive</a>
        <p class="eyebrow">Field note / {post.data.tags?.[0] ?? 'essay'}</p>
        <h1>
          {post.data.title.split(' ').map((word, i) => <span style={`--delay: ${i * 0.05}s`}>{word}</span>)}
        </h1>
        <p class="description anim-fade">{post.data.description}</p>
        <div class="meta anim-fade">
          <a href='/' class="author">By {data.profile.name}</a>
          <span class="meta-item">
            <AbsoluteTime datetime={post.data.pubDate} format={{ month: "long", day: "numeric", year: "numeric" }} />
          </span>
          <span class="meta-item">{post.readingTime} min read</span>
        </div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="tags anim-fade">
            {post.data.tags.map((tag, i) => (
              <span class="tag" style={`--tag-delay: ${i * 0.05}s`}>{tag}</span>
            ))}
          </div>
        )}

        {post.audioUrl && (
          <div class="audio-player anim-fade" style="margin-top: var(--gap);">
            <p style="font-size: 0.8rem; text-transform: uppercase; font-weight: 600; color: var(--color-text-light); margin-bottom: 0.5rem;">Listen to this article</p>
            <audio controls src={post.audioUrl} style="width: 100%;">
              Your browser does not support the audio element.
            </audio>
          </div>
        )}
      </header>

      <div class="content-wrapper">
        {hasToC && (
          <aside class="toc">
            <h4>Contents</h4>
            <ul>
              {tocHeadings.map(h => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
        <div class='content anim-fade-up' set:html={html} />
      </div>

      <!-- Previous/Next navigation -->
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/posts/${prevPost.id}`} class="nav-link nav-prev">
            <span class="nav-label">Previous</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/posts/${nextPost.id}`} class="nav-link nav-next">
            <span class="nav-label">Next</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    </div>
  </article>
</Html>

<style>
  article {
    --ink: #0a0a09;
    --paper: #efede3;
    --pink: #f22987;
    min-height: 100vh;
    overflow-x: clip;
    background:
      linear-gradient(rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px,
      linear-gradient(90deg, rgba(239,237,227,.055) 1px, transparent 1px) 0 0 / 58px 58px,
      var(--ink);
    color: var(--paper);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .filters { position: absolute; width: 0; height: 0; }
  .hero-image {
    position: relative;
    width: 100%;
    height: min(72svh, 760px);
    min-height: 520px;
    overflow: hidden;
    background: #333;
  }
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, rgba(239,237,227,.18) 0 1px, transparent 1.3px) 0 0 / 4px 4px,
      linear-gradient(0deg, rgba(10,10,9,.75), transparent 60%);
    pointer-events: none;
  }
  .hero-image :global(picture), .hero-image :global(img) { width: 100%; height: 100%; }
  .hero-image :global(img) { display: block; object-fit: cover; object-position: center; filter: grayscale(1) contrast(1.32); transform: scale(1.04); }
  .article-container { position: relative; max-width: 1280px; margin: 0 auto; padding: 0 clamp(14px, 4vw, 64px) 90px; }
  header {
    position: relative;
    z-index: 1;
    isolation: isolate;
    max-width: 1080px;
    margin: -165px 0 100px;
    padding: clamp(48px, 7vw, 90px);
    color: var(--ink);
  }
  header a { text-decoration: none; }
  header::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    filter: url('#article-paper-tear');
    background: #f4f1e7;
  }
  .back-link, .eyebrow, .meta, .tags, .toc, .nav-label {
    font-family: 'VT323', monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .back-link { display: inline-block; margin-bottom: 70px; color: var(--ink); font-size: 13px; }
  .back-link:hover { color: var(--pink); }
  .eyebrow { margin: 0 0 20px; color: var(--pink); font-size: 14px; }
  h1 {
    display: flex;
    flex-wrap: wrap;
    gap: .04em .13em;
    max-width: 11ch;
    margin: 0;
    font: 400 clamp(4rem, 8vw, 8.4rem)/.79 'Archivo Black', sans-serif;
    letter-spacing: -.07em;
    text-transform: uppercase;
  }
  h1 span { display: inline-block; }
  h1 span:nth-child(4n) { color: var(--pink); }
  .description { max-width: 50ch; margin: 38px 0 30px; font-size: clamp(1.15rem, 1.8vw, 1.55rem); line-height: 1.3; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 0 0 20px; color: #585750; font-size: 13px; }
  .author { padding: 6px 9px; background: var(--ink); color: var(--paper); }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .tag { padding: 5px 8px; background: rgba(10,10,9,.09); color: #45443f; font-size: 12px; }
  .audio-player { padding-top: 24px; border-top: 1px solid rgba(10,10,9,.35); }
  .audio-player audio { filter: grayscale(1); }
  .content-wrapper { display: grid; grid-template-columns: minmax(0, 800px) 220px; justify-content: center; align-items: start; gap: clamp(30px, 5vw, 76px); }
  .content {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    z-index: 0;
    isolation: isolate;
    min-width: 0;
    padding: clamp(44px, 6vw, 82px);
    color: var(--ink);
  }
  .content::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    filter: url('#article-paper-tear');
    background: #f4f1e7;
  }
  .content :global(p), .content :global(ul), .content :global(ol) { margin: 0 0 1.65em; }
  .content :global(p) { line-height: 1.82; }
  .content :global(p:first-of-type::first-letter) {
    float: left;
    margin: .06em .12em 0 0;
    color: var(--pink);
    font: 400 5.6rem/.72 'Fraunces', serif;
  }
  .content :global(h2) {
    margin: 2.2em 0 .72em;
    color: var(--pink);
    font: 400 clamp(2.5rem, 5vw, 5rem)/.84 'Archivo Black', sans-serif;
    letter-spacing: -.065em;
    text-transform: uppercase;
  }
  .content :global(h2[id]), .content :global(h3[id]) { scroll-margin-top: 96px; }
  .content :global(h2:first-child) { margin-top: 0; }
  .content :global(h3) {
    margin: 2.1em 0 .7em;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
    font: 700 clamp(1.5rem, 2.6vw, 2.2rem)/1 'Archivo Narrow', sans-serif;
    letter-spacing: .01em;
    text-transform: uppercase;
  }
  .content :global(h4), .content :global(h5), .content :global(h6) { margin: 1.8em 0 .6em; font-family: 'Archivo Narrow', sans-serif; text-transform: uppercase; }
  .content :global(h1 a), .content :global(h2 a), .content :global(h3 a), .content :global(h4 a), .content :global(h5 a), .content :global(h6 a) { color: inherit; text-decoration: none; }
  .content :global(ul), .content :global(ol) { padding-left: 1.35em; }
  .content :global(li) { margin: .5em 0; }
  .content :global(li::marker) { color: var(--pink); }
  .content :global(a) { color: inherit; text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .content :global(a:hover) { color: var(--pink); }
  .content :global(strong) { font-weight: 700; text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 3px; text-underline-offset: 2px; }
  .content :global(blockquote) {
    position: relative;
    margin: 2.4em -4% 2.4em 4%;
    padding: clamp(28px, 5vw, 54px);
    background: var(--ink) url('/paper-grain-light.webp') 0 0 / 192px 192px repeat;
    color: var(--paper);
    font: 600 clamp(1.25rem, 2vw, 1.65rem)/1.35 'Fraunces', serif;
    transform: rotate(-.7deg);
  }
  .content :global(blockquote::before) { content: '“'; position: absolute; top: -28px; left: 18px; color: var(--pink); font: 400 7rem 'Fraunces', serif; }
  .content :global(blockquote p:last-child) { margin-bottom: 0; }
  .content :global(code:not(pre code)) { padding: 2px 6px; background: rgba(10,10,9,.1); font-family: 'JetBrains Mono', monospace; font-size: .88em; }
  .content :global(pre) { max-width: 100%; margin: 2em 0; padding: 24px; overflow-x: auto; background: var(--ink); color: var(--paper); font: .88rem/1.65 'JetBrains Mono', monospace; }
  .content :global(table) { display: block; max-width: 100%; margin: 2em 0; overflow-x: auto; border-collapse: collapse; overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; }
  .content :global(th), .content :global(td) { min-width: 130px; padding: 10px 12px; border: 1px solid rgba(10,10,9,.35); text-align: left; }
  .content :global(th) { background: var(--ink); color: var(--paper); font-family: 'Archivo Narrow', sans-serif; text-transform: uppercase; }
  .content :global(.content-image), .content :global(img) { display: block; max-width: 100%; height: auto; margin: 2em 0; filter: grayscale(1) contrast(1.15); }
  .content :global(.content-figure) { margin: 2em 0; }
  .content :global(.content-figure img) { margin-bottom: 0; }
  .content :global(figcaption) { margin-top: 10px; color: #66645e; font: 13px 'VT323', monospace; text-align: center; }
  .content :global(.bot-message) { margin: 2em 0; background: rgba(10,10,9,.07); border-left: 5px solid var(--pink); }
  .content :global(.bot-header) { padding: 9px 14px; background: var(--ink); color: var(--paper); font: 13px 'VT323', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .content :global(.bot-content) { padding: 20px; font-family: 'JetBrains Mono', monospace; font-size: .9rem; }
  .content :global(.bot-content p:first-of-type::first-letter) { float: none; margin: 0; color: inherit; font: inherit; }
  .toc { position: sticky; grid-column: 2; grid-row: 1; top: 92px; padding-top: 18px; border-top: 2px solid var(--pink); color: #aaa79d; font-size: 13px; }
  .toc h4 { margin: 0 0 20px; color: var(--paper); font: 700 1rem 'Archivo Narrow', sans-serif; letter-spacing: .05em; text-transform: uppercase; }
  .toc ul { margin: 0; padding: 0; list-style: none; }
  .toc li { margin: 0; }
  .toc a { display: block; padding: 8px 0; color: #aaa79d; line-height: 1.2; text-decoration: none; }
  .toc a:hover, .toc a.active { color: var(--pink); }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 1020px; margin: 90px auto 0; }
  .post-nav > div { min-height: 1px; }
  .nav-link { display: flex; min-height: 210px; flex-direction: column; justify-content: space-between; padding: 28px; background: #191918; color: var(--paper); text-decoration: none; }
  .nav-link:hover { background: var(--pink); color: var(--ink); }
  .nav-next { text-align: right; }
  .nav-label { color: var(--pink); font-size: 13px; }
  .nav-link:hover .nav-label { color: var(--ink); }
  .nav-title { max-width: 18ch; font: 400 clamp(1.7rem, 3vw, 3rem)/.9 'Archivo Black', sans-serif; letter-spacing: -.045em; text-transform: uppercase; }
  .nav-next .nav-title { align-self: flex-end; }
  [data-parallax-bg] img { transition: transform .12s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes wordIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  .anim-hero { animation: fadeIn .7s ease-out both; }
  h1 span { animation: wordIn .35s ease-out both; animation-delay: var(--delay, 0s); }
  .anim-fade { animation: fadeIn .45s ease-out .2s both; }
  .anim-fade-up { animation: fadeInUp .55s ease-out .3s both; }
  @media (max-width: 900px) {
    .hero-image { height: 48svh; min-height: 340px; }
    .article-container { padding-inline: 10px; }
    header { margin-top: -76px; margin-bottom: 64px; padding: 48px 26px; }
    .back-link { margin-bottom: 54px; }
    h1 { font-size: clamp(3rem, 13vw, 5.7rem); }
    .description { margin-top: 28px; font-size: 1.08rem; }
    .content-wrapper { display: block; }
    .content { padding: 44px 26px; }
    .toc { display: none; }
    .post-nav { grid-template-columns: 1fr; margin-top: 64px; }
    .nav-next { text-align: left; }
    .nav-next .nav-title { align-self: flex-start; }
    .content :global(blockquote) { margin-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .anim-hero, h1 span, .anim-fade, .anim-fade-up { animation: none; }
    [data-parallax-bg] img { transition: none; }
  }
  @media print {
    article, .content { background: #fff; color: #000; }
    .hero-image, .toc, .post-nav, .back-link, .filters { display: none; }
    .article-container { max-width: none; padding: 0; }
    header, .content { margin: 0; padding: 0; }
    header::before, .content::before { display: none; }
    h1 { font-size: 2.4rem; }
  }
</style>

<script>
  // Hero image parallax
  const heroBg = document.querySelector('[data-parallax-bg] img') as HTMLElement | null;

  function updateParallax() {
    const scrollY = window.scrollY;
    if (heroBg && scrollY < window.innerHeight) {
      heroBg.style.transform = `translateY(${scrollY * 0.3}px) scale(1.1)`;
    }
  }

  window.addEventListener('scroll', updateParallax, { passive: true });
  updateParallax();

  // ToC active section highlighting
  const tocLinks = document.querySelectorAll('.toc a');
  const headings = document.querySelectorAll('.content h2[id]');

  if (tocLinks.length > 0 && headings.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
            });
          }
        });
      },
      {
        rootMargin: '-80px 0px -70% 0px',
        threshold: 0,
      }
    );

    headings.forEach((heading) => observer.observe(heading));
  }
</script>

