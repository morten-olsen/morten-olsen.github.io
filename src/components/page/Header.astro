---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/posts/', label: 'Writings' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Morten Olsen, home">Morten Olsen<span>.pro</span></a>
    <nav class="links" aria-label="Primary navigation">
      {links.map((link, index) => (
        <a class:list={['link', { active: isActive(link.href) }]} href={link.href}>
          <span class="index">{String(index + 1).padStart(2, '0')}</span>
          <span class="label">{link.label}</span>
        </a>
      ))}
    </nav>
    <p class="note">Ideas. Systems. Humans.<i aria-hidden="true"></i></p>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: url('/paper-grain-light.webp') 0 0 / 192px 192px repeat, #0a0a09;
    background-blend-mode: screen;
    color: #efede3;
    border-bottom: 1px solid rgba(239,237,227,.55);
  }

  .header::after {
    content: '';
    position: absolute;
    inset: auto 0 -7px;
    height: 8px;
    background: #0a0a09;
    clip-path: polygon(0 0,2% 65%,5% 25%,9% 72%,13% 38%,18% 80%,24% 29%,31% 73%,38% 30%,46% 76%,53% 38%,61% 73%,70% 26%,78% 69%,87% 36%,94% 78%,100% 22%,100% 0);
    pointer-events: none;
  }

  .header-inner {
    min-height: 62px;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 30px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 30px;
  }

  .wordmark {
    color: #efede3;
    font: 400 17px 'Archivo Black', sans-serif;
    font-kerning: normal;
    font-feature-settings: 'kern' 1;
    letter-spacing: .045em;
    text-transform: uppercase;
    text-rendering: optimizeLegibility;
  }

  .wordmark span {
    margin-left: .035em;
    letter-spacing: .015em;
  }

  .links {
    display: flex;
    gap: clamp(18px,3vw,42px);
  }

  .link {
    position: relative;
    display: flex;
    gap: 5px;
    padding: 5px 0;
    color: #efede3;
    font: 700 13px 'Space Grotesk', sans-serif;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .link::after {
    content: '';
    position: absolute;
    inset: auto auto 0 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 160ms ease;
  }

  .link:hover::after,
  .link.active::after { width: 100%; }
  .link.active .index { color: #f22987; }

  .note {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #efede3;
    font: 13px 'VT323', monospace;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .note i { width: 9px; height: 9px; border-radius: 50%; background: #f22987; }

  @media (max-width: 760px) {
    .header-inner { min-height: 54px; grid-template-columns: 1fr auto; gap: 16px; padding: 0 18px; }
    .wordmark { font-size: 14px; }
    .links { gap: 17px; }
    .label, .note { display: none; }
    .link { font-size: 14px; }
  }
</style>
