---
import { data } from '~/data/data';

const profile = data.profile;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="statement">
    <p class="chapter">End note / keep looking</p>
    <strong>Stay curious.<br /><span>Build with context.</span></strong>
    <p class="aside">Technology is never only technical.<br />The consequences belong in the design.</p>
  </div>

  <div class="footer-grid">
    <div class="identity">
      <a class="monogram" href="/" aria-label="Home">MØ</a>
      <p>Independent software engineer<br />Copenhagen, Denmark</p>
    </div>

    <nav class="site-links" aria-label="Footer navigation">
      <a href="/posts/"><span>01</span> Writings</a>
      <a href="/projects/"><span>02</span> Projects</a>
      <a href="/about/"><span>03</span> About</a>
      <a href="/cv.pdf"><span>04</span> CV</a>
    </nav>

    <nav class="social-links" aria-label="Social profiles">
      {Object.entries(profile.profiles).map(([id, item]) => (
        <a href={item.url} target="_blank" rel="noopener noreferrer">{item.network?.name || id}<b aria-hidden="true">↗</b></a>
      ))}
      <a href="/posts/rss.xml">RSS <b aria-hidden="true">↗</b></a>
    </nav>
  </div>

  <div class="status">
    <span>© {year} Morten Olsen</span>
    <span>Code \ ideas \ people \ context</span>
    <span class="signal">Still human<i aria-hidden="true"></i></span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: url('/paper-grain-light.webp') 0 0 / 192px 192px repeat, #0a0a09;
    background-blend-mode: screen;
    color: #efede3;
    border-top: 1px solid #0a0a09;
  }

  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 10px;
    background: #efede3;
    clip-path: polygon(0 0,2% 55%,6% 14%,11% 62%,17% 19%,24% 70%,31% 25%,39% 64%,47% 18%,55% 69%,64% 26%,72% 61%,81% 21%,90% 66%,96% 28%,100% 55%,100% 0);
  }

  .statement {
    position: relative;
    min-height: 280px;
    padding: 48px clamp(24px,6vw,96px);
    background: url('/paper-grain.webp') 0 0 / 192px 192px repeat, #f22987;
    background-blend-mode: multiply;
    color: #0a0a09;
  }

  .chapter {
    margin: 0 0 18px;
    font: 13px 'VT323', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .statement strong {
    display: block;
    max-width: 950px;
    font: 400 clamp(3rem,7vw,7rem)/.82 'Archivo Black', sans-serif;
    letter-spacing: -.07em;
    text-transform: uppercase;
  }

  .statement strong span { color: #efede3; }
  .aside { position: absolute; right: clamp(24px,6vw,96px); bottom: 42px; margin: 0; font: 15px/1.15 'VT323', monospace; }

  .footer-grid {
    max-width: 1480px;
    margin: 0 auto;
    padding: 42px 30px;
    display: grid;
    grid-template-columns: 1.3fr 1fr .7fr;
    gap: 60px;
  }

  .identity { display: flex; align-items: flex-start; gap: 24px; }
  .identity p { margin: 3px 0 0; color: #aaa79d; font: 14px/1.25 'VT323', monospace; text-transform: uppercase; }
  .monogram { color: #efede3; font: 400 31px 'Archivo Black', sans-serif; transform: skew(-8deg); }
  .site-links, .social-links { display: flex; flex-direction: column; }
  .site-links a, .social-links a { padding: 7px 0; border-bottom: 1px solid rgba(239,237,227,.25); color: #efede3; font: 15px 'VT323', monospace; letter-spacing: .04em; text-transform: uppercase; }
  .site-links a:hover, .social-links a:hover { color: #f22987; }
  .site-links span { display: inline-block; width: 28px; color: #f22987; }
  .social-links a { display: flex; justify-content: space-between; }
  .social-links b { color: #f22987; }

  .status {
    min-height: 38px;
    padding: 0 30px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-top: 1px solid rgba(239,237,227,.4);
    color: #aaa79d;
    font: 11px 'VT323', monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .status > :nth-child(2) { text-align: center; }
  .signal { justify-self: end; display: flex; align-items: center; gap: 9px; }
  .signal i { width: 8px; height: 8px; border-radius: 50%; background: #f22987; }

  @media (max-width: 700px) {
    .statement { min-height: 310px; padding: 40px 20px; }
    .statement strong { font-size: clamp(2.8rem,14vw,5rem); }
    .aside { right: 20px; bottom: 30px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; padding: 34px 20px; }
    .identity { grid-column: 1 / -1; }
    .status { grid-template-columns: 1fr auto; padding: 0 20px; }
    .status > :nth-child(2) { display: none; }
  }
</style>
