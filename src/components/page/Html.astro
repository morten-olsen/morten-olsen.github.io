---
import { icons } from '~/assets/images/images.icons';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '@fontsource/archivo-black/400.css';
import '@fontsource/archivo-narrow/700.css';
import '@fontsource/rock-salt/400.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/vt323/400.css';

type Props = {
  title: string;
  description: string;
  jsonLd?: unknown;
  image?: string;
  themeColor?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
};

const {
  title,
  description,
  jsonLd,
  themeColor,
  image,
  hideHeader,
  hideFooter,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;
const schema = JSON.stringify(jsonLd);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : image;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor ?? '#0a0a09'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/posts/rss.xml" />
    <script is:inline defer src="https://umami.olsen.cloud/script.js" data-website-id="3284fd7a-6452-4048-8c8c-19740171b793"></script>

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && tags?.map(tag => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {jsonLd && <script type="application/ld+json" is:inline set:html={schema} />}
    {icons.pngs.map(icon => <link rel="icon" href={icon.src} type="image/png" sizes={icon.size} />)}
    <title>{title}</title>
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>

<script is:inline>
  document.querySelectorAll('[data-fadein]').forEach((node) => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          node.classList.remove('hidden');
          node.setAttribute('data-shown', 'true');
        } else if (!node.hasAttribute('data-shown')) {
          node.classList.add('hidden');
        }
      });
    });
    observer.observe(node);
  });
</script>

<style is:global>
  @layer reset, tokens, base, utilities;

  @layer reset {
    *, *::before, *::after { box-sizing: border-box; }
    * { margin: 0; padding: 0; }
    html { min-width: 320px; scroll-behavior: smooth; overflow-x: hidden; }
    body { min-height: 100%; overflow-x: clip; }
    img, picture, svg { max-width: 100%; }
    ul, ol { list-style: none; }
    button, input, textarea, select { font: inherit; }
  }

  @layer tokens {
    :root {
      --page-bg: #efede3;
      --card-bg: #efede3;
      --c-bg-em: #d7d5cd;
      --t-fg: #0a0a09;
      --color-text-light: #5f5d57;
      --color-link: #0a0a09;
      --border-color: #0a0a09;
      --on-accent: #0a0a09;
      --accent-primary: #f22987;
      --accent-secondary: #f22987;
      --accent-tertiary: #b9b7af;
      --accent-lime: #efede3;
      --accent-lavender: #aaa8a1;
      --accent-blink: #f22987;
      --border-width: 1px;
      --shadow-offset: 4px;
      --shadow-brutal: 4px 4px 0 #0a0a09;
      --shadow-brutal-lg: 7px 7px 0 #0a0a09;
      --radius: 0;
      --radius-sm: 0;
      --content-width: 1180px;
      --gap: 16px;
      --font-family: 'Space Grotesk', system-ui, sans-serif;
      --font-family-display: 'Archivo Black', Impact, sans-serif;
      --font-family-heading: var(--font-family-display);
      --font-family-mono: 'VT323', ui-monospace, monospace;
      --letter-spacing: .02em;
      --fw-df: 400;
      --fw-md: 700;
      --fs-sm: 14px;
      --fs-md: 16px;
      --font-xxl: clamp(3rem, 8vw, 7rem);
      --font-xl: clamp(1.8rem, 4vw, 3.2rem);
      --font-lg: 1.25rem;
      --font-sm: .875rem;
      --font-xs: .75rem;
      --space-xs: .25rem;
      --space-sm: .5rem;
      --space-md: 1rem;
      --space-lg: 2rem;
      --space-xl: 3rem;
      --space-xxl: 4rem;
      --duration-fast: .14s;
      --duration-normal: .3s;
      --duration-slow: .5s;
      --duration-glacial: .8s;
      --ease-out: cubic-bezier(.16,1,.3,1);
      --ease-bounce: cubic-bezier(.34,1.56,.64,1);
    }
  }

  @layer base {
    body {
      position: relative;
      background: var(--page-bg);
      color: var(--t-fg);
      font: var(--fw-df) var(--fs-md)/1.55 var(--font-family);
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 999;
      pointer-events: none;
      opacity: .68;
      background: url('/paper-grain.webp') 0 0 / 192px 192px repeat;
      mix-blend-mode: multiply;
    }

    h1, h2, h3, h4, h5, h6 { font-family: var(--font-family-heading); font-weight: 400; letter-spacing: -.045em; }
    a { color: inherit; text-decoration: none; }
    p { margin-bottom: var(--gap); }
    p a { text-decoration: underline; text-decoration-color: var(--accent-secondary); text-decoration-thickness: 2px; text-underline-offset: 3px; }
    p a:hover { background: var(--accent-secondary); color: var(--on-accent); }
    code, kbd, samp, pre { font-family: var(--font-family-mono); }
    img { filter: grayscale(1) contrast(1.12); }
    ::selection { background: var(--accent-secondary); color: var(--on-accent); }
    :focus-visible { outline: 3px solid var(--accent-secondary); outline-offset: 3px; }
    [data-fadein] { transition: opacity var(--duration-glacial), transform var(--duration-glacial); }
    [data-fadein].hidden { opacity: 0; transform: translateY(12px); }
  }

  @layer utilities {
    .brutal-border { border: var(--border-width) solid var(--border-color); }
    .brutal-shadow { box-shadow: var(--shadow-brutal); }
    [data-accent-bg] { color: var(--on-accent); }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }

  @media print {
    body { background: #fff; color: #000; font-family: Georgia, serif; }
    body::before, header.header, footer.footer { display: none !important; }
  }
</style>
